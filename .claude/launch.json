{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laptops-hub-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3000", "-H", "127.0.0.1"],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "isolated-app",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3001", "-H", "127.0.0.1"],
      "env": { "THEME_PUBLISHED_ENABLED": "1" },
      "port": 3001,
      "url": "http://127.0.0.1:3001"
    },
    {
      "name": "fake-resend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/test-fixtures/fake-resend.mjs"],
      "port": 4599
    }
  ]
}
